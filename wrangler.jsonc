// Cloudflare deployment: serves the game as static files at johnshawler.com/piano-quest.
// Deploy with: npm run deploy
{
  "name": "piano-quest",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "johnshawler.com/piano-quest", "zone_name": "johnshawler.com" },
    { "pattern": "johnshawler.com/piano-quest/*", "zone_name": "johnshawler.com" }
  ]
}
